# Copy to .env and fill in. NEVER commit .env.

# ---- Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=            # service_role key. Treat as a prod password.
SUPABASE_ANON_KEY=               # safe for client-side use

# ---- The Odds API  (the-odds-api.com -- note the hyphens)
ODDS_API_KEY=                    # 32-char hex key from the-odds-api.com
# credits/month for your plan (informational; nothing reads this yet)
ODDS_API_TIER=100K

# ---- SportsDataIO (injuries / practice participation)
SPORTSDATA_API_KEY=              # trial key from sportsdata.io (Injuries feed)

# ---- Anthropic (presser extraction)
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5-20251001   # cheap; extraction is a simple task

# ---- Vercel Cron (protects your cron routes from public calls)
CRON_SECRET=                     # generate: openssl rand -hex 32
